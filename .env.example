# Alpaca API Credentials (Paper Trading)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_PAPER=true

# LLM Provider (Google Gemini)
GOOGLE_API_KEY=your_google_api_key_here
LLM_MODEL=gemini-2.5-flash

# Agent Settings
AGENT_SCHEDULE_TIMES=10:00,15:00
AGENT_TIMEZONE=US/Eastern
LOG_LEVEL=INFO

# 0DTE Iron Condor Strategy (Optional)
CONDOR_WING_WIDTH=5
CONDOR_TARGET_DELTA=0.10
CONDOR_PROFIT_TARGET_PCT=0.50
CONDOR_STOP_LOSS_PCT=2.0
CONDOR_MAX_CAPITAL_PCT=0.80
CONDOR_CLOSE_BEFORE_MINUTES=15
